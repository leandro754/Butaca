// Butaca: 16 entidades de DrawDB mas evidencias KYC de la implementacion.
// Snapshot: docs/drawdb-butaca-modelado-datos.json. Sin modificar el diagrama remoto.

enum estado_compra {
	PENDIENTE
	CONFIRMADA
	CANCELADA
}

enum estado_entrada {
	CONFIRMADA
	USADA
	ANULADA
}

enum estado_evento {
	BORRADOR
	PUBLICADO
	CANCELADO
}

enum estado_usuario {
	ACTIVO
	INACTIVO
	SUSPENDIDO
}

enum estado_envio_notificacion {
	ENVIADA
	FALLIDA
	PENDIENTE
}

enum estado_pago {
	PENDIENTE
	APROBADO
	RECHAZADO
	REEMBOLSADO
	CANCELADO
}

enum estado_reembolso {
	PENDIENTE
	APROBADO
	RECHAZADO
	PROCESADO
	CANCELADO
}

enum metodo_verificacion {
	BIOMETRIA_RENAPER
	DOCUMENTO_DNI
	OTP_EMAIL
}

enum estado_verificacion {
	PENDIENTE
	VERIFICADA
	RECHAZADA
}

enum tipo_comprobante {
	RECIBO_DIGITAL
	FACTURA_B
	FACTURA_C
}

enum estado_envio_comprobante {
	PENDIENTE
	ENVIADO
	ERROR_ENVIO
}

Table rol [headercolor: #ff6363] {
	id_rol bigint [ pk, increment, not null, note: 'Identificador unico del rol.' ]
	nombre_rol varchar(20) [ not null, unique, note: 'ADMIN, ORGANIZADOR o CLIENTE.' ]
	created_at timestamp [ not null, default: now(), note: 'Auditoria tecnica heredada por las entidades JPA.' ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	Note: '''Catalogo de roles del sistema. Separarlo de usuario evita repetir el nombre del rol y escribir valores diferentes para un mismo perfil.

CHECK constraints:
- nombre_rol IN ('ADMIN', 'ORGANIZADOR', 'CLIENTE')'''
}

Table usuario [headercolor: #ff6363] {
	id_usuario bigint [ pk, increment, not null, note: 'Identificador unico de la cuenta.' ]
	id_persona bigint [ note: 'Opcional hasta que la cuenta sea vinculada con una identidad real.' ]
	id_rol bigint [ not null, note: 'Rol asignado al usuario.' ]
	estado_usuario estado_usuario [ not null, default: 'ACTIVO', note: 'Estado de la cuenta: ACTIVO, INACTIVO o SUSPENDIDO.' ]
	email_usuario varchar(255) [ not null, unique ]
	password_hash_usuario varchar(255) [ not null, note: 'Contrasena cifrada; nunca se devuelve desde la API.' ]
	telefono_usuario varchar(20)
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(id_persona) [ name: 'idx_usuario_persona' ]
		(id_rol) [ name: 'idx_usuario_rol' ]
		(estado_usuario) [ name: 'idx_usuario_estado' ]
	}

	Note: 'Guarda clientes, organizadores y administradores. El rol determina que operaciones puede realizar cada usuario. estado_usuario permite suspender o desactivar la cuenta.'
}

Table persona [headercolor: #ff6363] {
	id_persona bigint [ pk, increment, not null, note: 'Identificador unico de la persona.' ]
	dni_persona bigint [ not null, unique, note: 'Identificador unico de la persona.' ]
	nombre_persona varchar(100) [ not null ]
	apellido_persona varchar(100) [ not null ]
	email_persona varchar(255) [ note: 'Email de contacto del titular. Puede no tener cuenta de usuario.' ]
	telefono_persona varchar(30) [ note: 'Telefono de contacto del titular. Puede no tener cuenta de usuario.' ]
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(email_persona) [ name: 'idx_persona_email' ]
	}

	Note: 'Representa la identidad real de una persona. Una persona puede asociarse a varias cuentas y ser titular de distintas entradas. Los datos de contacto permiten notificar al titular aunque no tenga cuenta.'
}

Table ubicacion [headercolor: #8eb7ff] {
	id_ubicacion bigint [ pk, increment, not null, note: 'Identificador unico del lugar.' ]
	nombre_ubicacion varchar(150) [ not null ]
	direccion_ubicacion varchar(255) [ not null ]
	capacidad_maxima_ubicacion int [ not null, default: 10000, note: 'Capacidad fisica maxima del recinto para validar que el cupo_total_evento no la supere.' ]
	activa_ubicacion boolean [ not null, default: true ]
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(nombre_ubicacion, direccion_ubicacion) [ name: 'uq_ubicacion_nombre_direccion', unique ]
	}

	Note: 'Representa el lugar fisico donde se realiza un evento. Evento guarda solamente la FK de la ubicacion y no repite el nombre o la direccion.'
}

Table categoria [headercolor: #8eb7ff] {
	id_categoria bigint [ pk, increment, not null, note: 'Identificador unico de la categoria.' ]
	nombre_categoria varchar(100) [ not null, unique ]
	descripcion_categoria text [ not null ]
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	Note: 'Clasifica eventos, por ejemplo Musica, Teatro o Deportes. Una categoria puede utilizarse en muchos eventos.'
}

Table evento [headercolor: #8eb7ff] {
	id_evento bigint [ pk, increment, not null, note: 'Identificador unico del evento.' ]
	id_usuario_organizador bigint [ not null, note: 'Usuario ORGANIZADOR responsable.' ]
	id_ubicacion bigint [ not null, note: 'Lugar donde se realiza el evento.' ]
	id_categoria bigint [ not null, note: 'Categoria utilizada para clasificar el evento.' ]
	titulo_evento varchar(200) [ not null ]
	descripcion_evento text
	fecha_evento date [ not null ]
	hora_evento time [ not null ]
	cupo_total_evento int [ not null, note: 'Cantidad maxima de entradas que puede emitir el evento.' ]
	estado_evento estado_evento [ not null, default: 'BORRADOR' ]
	imagen_url_evento text
	version_evento bigint [ not null, default: 0, note: 'Version para control de concurrencia optimista (@Version) al emitir entradas.' ]
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(id_usuario_organizador) [ name: 'idx_evento_organizador' ]
		(id_ubicacion) [ name: 'idx_evento_ubicacion' ]
		(id_categoria) [ name: 'idx_evento_categoria' ]
		(estado_evento, fecha_evento) [ name: 'idx_evento_estado_fecha' ]
	}

	Note: 'Publicacion creada por un organizador. Los clientes solo pueden ver eventos PUBLICADO que todavia tengan cupo. El cupo disponible se calcula restando del cupo total las entradas CONFIRMADA o USADA. Las tarifas y precios se configuran en tipo_entrada.'
}

Table entrada [headercolor: #4dee8a] {
	id_entrada bigint [ pk, increment, not null, note: 'Identificador interno del ticket.' ]
	codigo_unico_entrada uuid [ not null, unique, default: gen_random_uuid(), note: 'Codigo que identifica el ticket y se utiliza para validarlo.' ]
	id_evento bigint [ not null ]
	id_tipo_entrada bigint [ note: 'Tarifa aplicada. Nulo en entradas historicas; la aplicacion debe validar que el tipo pertenezca al mismo evento.' ]
	id_persona_titular bigint [ not null, note: 'Persona titular que utilizara la entrada.' ]
	id_compra bigint [ note: 'Puede ser nulo para una entrada de cortesia.' ]
	estado_entrada estado_entrada [ not null, default: 'CONFIRMADA' ]
	precio_pagado_entrada numeric(12,2) [ not null, note: 'Precio historico al momento de emitir el ticket.' ]
	moneda_entrada char(3) [ not null, default: 'ARS', note: 'Moneda del precio pagado; se congela junto con el precio historico.' ]
	fecha_emision_entrada timestamp [ not null, default: now() ]
	fecha_validacion_entrada timestamp [ note: 'Momento del primer uso; nulo mientras no fue utilizada.' ]
	version_entrada bigint [ not null, default: 0, note: 'Version para control de concurrencia optimista (@Version) al validar o anular el ticket.' ]
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(id_evento, estado_entrada) [ name: 'idx_entrada_evento_estado' ]
		(id_persona_titular, estado_entrada) [ name: 'idx_entrada_titular_estado' ]
		(id_compra) [ name: 'idx_entrada_compra' ]
		(id_tipo_entrada) [ name: 'idx_entrada_tipo_entrada' ]
	}

	Note: 'Cada fila es un ticket individual. Una compra de tres tickets crea tres entradas con codigos diferentes. El precio y la moneda se congelan aqui para que una modificacion del evento o de la tarifa no cambie compras anteriores.'
}

Table compra [headercolor: #4dee8a] {
	id_compra bigint [ pk, increment, not null, note: 'Identificador unico de la operacion.' ]
	id_usuario_comprador bigint [ not null, note: 'Usuario que realiza la compra.' ]
	fecha_compra timestamp [ not null, default: now() ]
	estado_compra estado_compra [ not null, default: 'PENDIENTE' ]
	moneda_compra char(3) [ not null, default: 'ARS', note: 'Moneda de la compra; debe coincidir con la de sus pagos y reembolsos.' ]
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(id_usuario_comprador, fecha_compra) [ name: 'idx_compra_usuario_fecha' ]
	}

	Note: 'Cabecera de la operacion. No contiene evento, cantidad ni total para evitar inconsistencias: esos datos se obtienen consultando las entradas de la compra. La moneda se fija aca y debe coincidir con la de los pagos.'
}

Table notificacion [headercolor: #8eb7ff] {
	id_notificacion bigint [ pk, increment, not null ]
	id_usuario bigint [ not null ]
	id_evento bigint [ note: 'Opcional: una notificacion general no necesita evento.' ]
	id_compra bigint
	tipo_notificacion varchar(20) [ not null, default: 'INFO' ]
	asunto_notificacion varchar(200)
	mensaje_notificacion text [ not null ]
	estado_envio_notificacion estado_envio_notificacion [ not null ]
	leida_notificacion boolean [ not null, default: false, note: 'Indica si el usuario destinatario ya marco la notificacion como leida en su bandeja.' ]
	fecha_envio_notificacion timestamp
	error_envio text
	created_at timestamp [ not null, default: now() ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicación o un trigger.' ]

	indexes {
		(id_usuario, created_at) [ name: 'idx_notificacion_usuario_fecha' ]
		(id_evento) [ name: 'idx_notificacion_evento' ]
		(id_compra) [ name: 'idx_notificacion_compra' ]
	}

	Note: '''Mensaje enviado a un usuario, por ejemplo una compra confirmada o la cancelacion de un evento. La relacion con evento es opcional.

CHECK constraints:
- fecha_envio_notificacion IS NULL OR fecha_envio_notificacion >= created_at'''
}

Table tipo_entrada [headercolor: #4dee8a] {
	id_tipo_entrada bigint [ pk, increment, not null, note: 'Identificador unico de la tarifa.' ]
	id_evento bigint [ not null, note: 'Evento al que pertenece la tarifa.' ]
	nombre_tipo_entrada varchar(100) [ not null, note: 'Nombre visible de la tarifa, por ejemplo General, VIP o Preventa.' ]
	descripcion_tipo_entrada text [ note: 'Descripcion o condiciones de la tarifa.' ]
	precio_tipo_entrada numeric(12,2) [ not null, note: 'Precio de lista de la tarifa.' ]
	moneda_tipo_entrada char(3) [ not null, default: 'ARS', note: 'Moneda del precio de lista.' ]
	activo_tipo_entrada boolean [ not null, default: true, note: 'Indica si la tarifa esta disponible para nuevas compras.' ]
	created_at timestamp [ not null, default: now(), note: 'Auditoria tecnica.' ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicacion o un trigger.' ]

	indexes {
		(id_evento) [ name: 'idx_tipo_entrada_evento' ]
		(id_evento, nombre_tipo_entrada) [ name: 'uq_tipo_entrada_evento_nombre', unique ]
	}

	Note: 'Tarifa configurada por evento (general, VIP, preventa, etc.). El precio de lista vive aca; entrada.precio_pagado conserva el precio historico.'
}

Table pago [headercolor: #fbbf24] {
	id_pago bigint [ pk, increment, not null, note: 'Identificador unico del pago.' ]
	id_compra bigint [ not null, note: 'Compra a la que corresponde el pago.' ]
	proveedor_pago varchar(50) [ not null, note: 'Proveedor o medio: MERCADO_PAGO, STRIPE, MANUAL, etc.' ]
	referencia_externa_pago varchar(255) [ note: 'Identificador del pago en el proveedor. Unico junto con el proveedor.' ]
	monto_pago numeric(12,2) [ not null, note: 'Monto efectivamente cobrado o intentado.' ]
	moneda_pago char(3) [ not null, default: 'ARS', note: 'Moneda del pago.' ]
	estado_pago estado_pago [ not null, default: 'PENDIENTE', note: 'Estado del pago: PENDIENTE, APROBADO, RECHAZADO, REEMBOLSADO o CANCELADO.' ]
	fecha_creacion_pago timestamp [ not null, default: now(), note: 'Fecha de creacion del intento de pago en el proveedor.' ]
	fecha_confirmacion_pago timestamp [ note: 'Fecha en que el proveedor confirmo el pago.' ]
	respuesta_proveedor_pago text [ note: 'Respuesta cruda del proveedor, serializada como JSON o texto.' ]
	created_at timestamp [ not null, default: now(), note: 'Auditoria tecnica.' ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicacion o un trigger.' ]

	indexes {
		(id_compra) [ name: 'idx_pago_compra' ]
		(estado_pago, fecha_creacion_pago) [ name: 'idx_pago_estado_fecha' ]
		(proveedor_pago, referencia_externa_pago) [ name: 'uq_pago_proveedor_referencia', unique ]
	}

	Note: 'Intento o confirmacion de pago de una compra. Una compra puede tener varios intentos; la aplicacion debe garantizar un solo pago APROBADO por compra.'
}

Table reembolso [headercolor: #fbbf24] {
	id_reembolso bigint [ pk, increment, not null, note: 'Identificador unico del reembolso.' ]
	id_pago bigint [ not null, note: 'Pago sobre el que se realiza la devolucion.' ]
	monto_reembolso numeric(12,2) [ not null, note: 'Monto devuelto.' ]
	moneda_reembolso char(3) [ not null, default: 'ARS', note: 'Moneda del reembolso.' ]
	motivo_reembolso text [ note: 'Motivo de la devolucion.' ]
	estado_reembolso estado_reembolso [ not null, default: 'PENDIENTE', note: 'Estado del reembolso: PENDIENTE, APROBADO, RECHAZADO, PROCESADO o CANCELADO.' ]
	referencia_externa_reembolso varchar(255) [ note: 'Identificador del reembolso en el proveedor.' ]
	fecha_solicitud_reembolso timestamp [ not null, default: now(), note: 'Fecha en que se solicito la devolucion.' ]
	fecha_procesamiento_reembolso timestamp [ note: 'Fecha en que el reembolso fue procesado.' ]
	created_at timestamp [ not null, default: now(), note: 'Auditoria tecnica.' ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicacion o un trigger.' ]

	indexes {
		(id_pago) [ name: 'idx_reembolso_pago' ]
		(estado_reembolso, fecha_solicitud_reembolso) [ name: 'idx_reembolso_estado_fecha' ]
		(referencia_externa_reembolso) [ name: 'uq_reembolso_referencia_externa', unique ]
	}

	Note: 'Devolucion total o parcial asociada a un pago. Varios reembolsos pueden existir para un mismo pago; la aplicacion debe validar que la suma no supere el monto pagado.'
}

Table verificacion_identidad [headercolor: #ff6363] {
	id_verificacion bigint [ pk, increment, not null, note: 'Identificador unico de la verificacion KYC.' ]
	id_usuario bigint [ not null, unique, note: 'Cuenta de usuario verificada (relacion 1 a 1).' ]
	metodo_verificacion metodo_verificacion [ not null, default: 'BIOMETRIA_RENAPER', note: 'Canal utilizado para validar la identidad: BIOMETRIA_RENAPER, DOCUMENTO_DNI u OTP_EMAIL.' ]
	estado_verificacion estado_verificacion [ not null, default: 'PENDIENTE', note: 'Estado del tramite KYC: PENDIENTE, VERIFICADA o RECHAZADA.' ]
	codigo_validacion_kyc varchar(100) [ not null, unique, note: 'Token o codigo externo unico devuelto por el validador de identidad.' ]
	observacion_verificacion varchar(255) [ note: 'Detalle o motivo de aprobacion/rechazo de la validacion.' ]
	fecha_solicitud timestamp [ not null, default: now(), note: 'Momento en que se inicio la validacion KYC.' ]
	fecha_verificacion timestamp [ note: 'Momento en que se resolvio la verificacion.' ]
	created_at timestamp [ not null, default: now(), note: 'Auditoria tecnica.' ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicacion o un trigger.' ]
	hash_evidencia_documental varchar(64)
	hash_selfie varchar(64)
	proveedor_identidad varchar(60)
	puntaje_coincidencia decimal(5,4)

	indexes {
		(estado_verificacion) [ name: 'idx_verificacion_estado' ]
		(id_usuario) [ name: 'idx_verificacion_usuario', unique ]
	}

	Note: 'Validacion KYC obligatoria del usuario antes de comprar entradas. No duplica DNI ni nombre porque se obtienen a traves de usuario -> persona.'
}

Table comprobante [headercolor: #fbbf24] {
	id_comprobante bigint [ pk, increment, not null, note: 'Identificador unico del comprobante emitido.' ]
	id_pago bigint [ not null, unique, note: 'Pago aprobado que respalda el comprobante (relacion 1 a 1).' ]
	numero_comprobante varchar(50) [ not null, unique, note: 'Numero correlativo legible del recibo o factura.' ]
	tipo_comprobante tipo_comprobante [ not null, default: 'RECIBO_DIGITAL', note: 'Tipo de documento: RECIBO_DIGITAL, FACTURA_B o FACTURA_C.' ]
	hash_cruce_seguridad varchar(64) [ not null, unique, note: 'Firma SHA-256 de integridad que cruza pago, compra y titular.' ]
	estado_envio_comprobante estado_envio_comprobante [ not null, default: 'ENVIADO', note: 'Estado del envio digital: PENDIENTE, ENVIADO o ERROR_ENVIO.' ]
	fecha_emision_comprobante timestamp [ not null, default: now(), note: 'Fecha y hora de emision del comprobante.' ]
	created_at timestamp [ not null, default: now(), note: 'Auditoria tecnica.' ]
	updated_at timestamp [ default: now(), note: 'Se actualiza en cada UPDATE desde la aplicacion o un trigger.' ]

	indexes {
		(fecha_emision_comprobante) [ name: 'idx_comprobante_fecha' ]
		(id_pago) [ name: 'idx_comprobante_pago', unique ]
	}

	Note: 'Recibo o factura digital emitida al aprobarse un pago. Incluye firma SHA-256 de cruce de seguridad sin duplicar id_compra ni id_usuario.'
}

Table historial_estado_entrada [headercolor: #4dee8a] {
	id_historial_entrada bigint [ pk, increment, not null, note: 'Identificador unico del cambio de estado del ticket.' ]
	id_entrada bigint [ not null, note: 'Entrada cuyo cambio de estado se audita.' ]
	id_usuario_responsable bigint [ note: 'Usuario (cliente, organizador o admin) que ejecuto el cambio de estado.' ]
	estado_anterior_entrada estado_entrada [ note: 'Estado previo del ticket (nulo en el alta inicial).' ]
	estado_nuevo_entrada estado_entrada [ not null, note: 'Nuevo estado asignado al ticket: CONFIRMADA, USADA o ANULADA.' ]
	motivo_cambio_entrada varchar(300) [ note: 'Motivo o contexto del cambio (ej. emision, lectura QR en puerta, anulacion).' ]
	fecha_cambio_entrada timestamp [ not null, default: now(), note: 'Fecha y hora exacta de la transicion de estado.' ]

	indexes {
		(id_entrada, fecha_cambio_entrada) [ name: 'idx_historial_entrada_fecha' ]
		(id_usuario_responsable) [ name: 'idx_historial_usuario_resp' ]
	}

	Note: 'Trazabilidad completa del ciclo de vida de cada entrada: emision inicial (CONFIRMADA), validacion nominal en puerta (USADA) o anulacion (ANULADA).'
}

Table auditoria_seguridad [headercolor: #c084fc] {
	id_auditoria bigint [ pk, increment, not null, note: 'Identificador unico del evento de seguridad.' ]
	id_usuario bigint [ note: 'Usuario actor que ejecuto la accion (nulo si fue un intento fallido anonimo).' ]
	accion_auditoria varchar(50) [ not null, note: 'Codigo de la accion auditada (LOGIN_EXITOSO, COMPRA_CONFIRMADA, VALIDACION_PUERTA, etc.).' ]
	entidad_afectada varchar(50) [ not null, note: 'Nombre de la tabla o entidad de negocio involucrada.' ]
	id_registro_afectado bigint [ note: 'ID primario del registro afectado dentro de la entidad.' ]
	resultado_auditoria varchar(20) [ not null, default: 'EXITOSO', note: 'Resultado de la operacion: EXITOSO, RECHAZADO o ERROR.' ]
	ip_origen varchar(45) [ note: 'Direccion IPv4 o IPv6 desde donde se origino la peticion.' ]
	detalle_tracking varchar(500) [ not null, note: 'Descripcion inmutable del evento para analisis forense.' ]
	fecha_auditoria timestamp [ not null, default: now(), note: 'Marca de tiempo inmutable (append-only) del evento.' ]

	indexes {
		(id_usuario, fecha_auditoria) [ name: 'idx_auditoria_usuario_fecha' ]
		(entidad_afectada, id_registro_afectado) [ name: 'idx_auditoria_entidad_registro' ]
		(accion_auditoria, fecha_auditoria) [ name: 'idx_auditoria_accion_fecha' ]
	}

	Note: 'Bitacora inmutable (append-only) de seguridad informatica y auditoria de operaciones criticas (login, KYC, compras, validacion en puerta).'
}

Ref fk_usuario_persona {
	persona.id_persona < usuario.id_persona [ delete: set null, update: cascade ]
}

Ref fk_usuario_rol {
	rol.id_rol < usuario.id_rol [ delete: restrict, update: cascade ]
}

Ref fk_evento_organizador {
	usuario.id_usuario < evento.id_usuario_organizador [ delete: restrict, update: cascade ]
}

Ref fk_evento_ubicacion {
	ubicacion.id_ubicacion < evento.id_ubicacion [ delete: restrict, update: cascade ]
}

Ref fk_evento_categoria {
	categoria.id_categoria < evento.id_categoria [ delete: restrict, update: cascade ]
}

Ref fk_compra_usuario {
	usuario.id_usuario < compra.id_usuario_comprador [ delete: restrict, update: cascade ]
}

Ref fk_entrada_compra {
	compra.id_compra < entrada.id_compra [ delete: restrict, update: cascade ]
}

Ref fk_entrada_evento {
	evento.id_evento < entrada.id_evento [ delete: restrict, update: cascade ]
}

Ref fk_entrada_titular {
	persona.id_persona < entrada.id_persona_titular [ delete: restrict, update: cascade ]
}

Ref fk_notificacion_usuario {
	usuario.id_usuario < notificacion.id_usuario [ delete: cascade, update: cascade ]
}

Ref fk_notificacion_evento {
	evento.id_evento < notificacion.id_evento [ delete: set null, update: cascade ]
}

Ref fk_compra_id_compra_notificacion {
	compra.id_compra < notificacion.id_compra [ delete: set null, update: cascade ]
}

Ref fk_tipo_entrada_evento {
	evento.id_evento < tipo_entrada.id_evento [ delete: restrict, update: cascade ]
}

Ref fk_entrada_tipo_entrada {
	tipo_entrada.id_tipo_entrada < entrada.id_tipo_entrada [ delete: restrict, update: cascade ]
}

Ref fk_pago_compra {
	compra.id_compra < pago.id_compra [ delete: restrict, update: cascade ]
}

Ref fk_reembolso_pago {
	pago.id_pago < reembolso.id_pago [ delete: restrict, update: cascade ]
}

Ref fk_verificacion_usuario {
	verificacion_identidad.id_usuario - usuario.id_usuario [ delete: cascade, update: cascade ]
}

Ref fk_comprobante_pago {
	comprobante.id_pago - pago.id_pago [ delete: restrict, update: cascade ]
}

Ref fk_historial_entrada {
	entrada.id_entrada < historial_estado_entrada.id_entrada [ delete: cascade, update: cascade ]
}

Ref fk_historial_usuario_responsable {
	usuario.id_usuario < historial_estado_entrada.id_usuario_responsable [ delete: set null, update: cascade ]
}

Ref fk_auditoria_usuario {
	usuario.id_usuario < auditoria_seguridad.id_usuario [ delete: set null, update: cascade ]
}
