Project butaca {
  database_type: 'PostgreSQL'

  Note: '''
  # Butaca - Modelo de Datos Relacional en 3FN y Seguridad Informática

  Modelo relacional normalizado en Tercera Forma Normal (3FN) y Forma Normal de
  Boyce-Codd (BCNF) para el proyecto académico Butaca.
  Gestiona usuarios, verificación de identidad (KYC), eventos, ubicaciones,
  categorías, compras, pasarela de pagos desacoplada (simulada en la demo),
  comprobantes con cruce criptográfico, entradas nominales, historial de tickets,
  notificaciones y auditoría/tracking de seguridad.

  El esquema aplica 3FN estricta y evita guardar valores calculados o redundantes:
  - el cupo disponible se calcula desde el cupo total y las entradas vigentes;
  - la cantidad y el total de una compra se calculan desde sus entradas;
  - pago.monto_pago es el importe autorizado externo y se cruza con la suma de entradas;
  - el comprobante se vincula directamente al pago aprobado (sin duplicar id_compra ni id_cliente);
  - la verificación de identidad se vincula al usuario sin repetir su nombre ni DNI;
  - el precio pagado y los datos nominales del asistente en cada entrada se conservan
    como hechos históricos inmutables del ticket emitido.

  La integración KYC/pago incluida es simulada: no hay conexión real con RENAPER
  ni con una pasarela. Para una base existente, la migración de los campos nuevos
  está en docs/migraciones/V2__kyc_pago_seguridad.sql.
  '''
}

Enum estado_usuario {
  ACTIVO
  INACTIVO
  SUSPENDIDO
}

Enum estado_verificacion {
  PENDIENTE
  VERIFICADA
  RECHAZADA
}

Enum metodo_verificacion {
  BIOMETRIA_RENAPER
  DOCUMENTO_DNI
  OTP_EMAIL
}

Enum estado_evento {
  BORRADOR
  PUBLICADO
  CANCELADO
}

Enum estado_compra {
  PENDIENTE
  CONFIRMADA
  CANCELADA
}

Enum pasarela_pago {
  MERCADOPAGO
  STRIPE
  MODO
  DEBITO_TOKENIZADO
}

Enum medio_pago {
  TARJETA_CREDITO
  TARJETA_DEBITO
  TRANSFERENCIA_CVU
  DINERO_CUENTA
}

Enum estado_pago {
  PENDIENTE
  APROBADO
  RECHAZADO
  REEMBOLSADO
}

Enum tipo_comprobante {
  RECIBO_DIGITAL
  FACTURA_B
  FACTURA_C
}

Enum estado_envio {
  PENDIENTE
  ENVIADO
  ERROR_ENVIO
}

Enum estado_entrada {
  CONFIRMADA
  USADA
  ANULADA
}

Table rol {
  id_rol bigint [pk, increment, note: 'Identificador único del rol.']
  nombre_rol varchar(20) [not null, unique, note: 'ADMIN, ORGANIZADOR o CLIENTE.']
  created_at timestamp [not null, default: `now()`, note: 'Auditoría técnica heredada por las entidades JPA.']
  updated_at timestamp

  checks {
    `nombre_rol IN ('ADMIN', 'ORGANIZADOR', 'CLIENTE')` [name: 'chk_rol_valido']
  }

  Note: '''
  Catálogo de roles del sistema. Separarlo de usuario evita repetir el nombre
  del rol y escribir valores diferentes para un mismo perfil (3FN).
  '''
}

Table usuario {
  id_usuario bigint [pk, increment, note: 'Identificador único del usuario.']
  id_rol bigint [not null, note: 'Rol asignado al usuario.']
  nombre_usuario varchar(100) [not null]
  apellido_usuario varchar(100) [not null]
  dni_usuario varchar(20) [unique, note: 'Documento Nacional de Identidad único de la persona titular de la cuenta.']
  email_usuario varchar(255) [not null, unique]
  password_hash_usuario varchar(255) [not null, note: 'Contraseña hasheada con BCrypt; nunca se devuelve desde la API.']
  telefono_usuario varchar(20)
  estado_usuario estado_usuario [not null, default: 'ACTIVO']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    id_rol [name: 'idx_usuario_rol']
    dni_usuario [name: 'idx_usuario_dni']
  }

  Note: '''
  Guarda clientes, organizadores y administradores. El rol determina qué
  operaciones puede realizar cada usuario. El DNI es único por persona.
  '''
}

Table verificacion_identidad {
  id_verificacion bigint [pk, increment, note: 'Identificador único del registro de verificación KYC.']
  id_usuario bigint [not null, unique, note: 'Usuario cuya identidad se valida antes de habilitar la compra.']
  metodo_verificacion metodo_verificacion [not null, default: 'BIOMETRIA_RENAPER']
  estado_verificacion estado_verificacion [not null, default: 'PENDIENTE']
  codigo_validacion_kyc varchar(100) [not null, unique, note: 'Token/hash devuelto por el proveedor de identidad (sin guardar biometría cruda por Ley 25.326).']
  observacion_verificacion varchar(255)
  hash_evidencia_documental varchar(64) [note: 'SHA-256 de la foto del DNI; la imagen no se persiste.']
  hash_selfie varchar(64) [note: 'SHA-256 de la selfie; la imagen no se persiste.']
  proveedor_identidad varchar(60) [note: 'Proveedor o simulador que resolvió el KYC.']
  puntaje_coincidencia decimal(5,4) [note: 'Puntaje de coincidencia devuelto por el proveedor.']
  fecha_solicitud timestamp [not null, default: `now()`]
  fecha_verificacion timestamp [note: 'Momento del último resultado del KYC (verificado o rechazado).']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (id_usuario, estado_verificacion) [name: 'idx_verificacion_usuario_estado']
  }

  Note: '''
  Verifica la identidad del usuario (KYC obligatorio antes de comprar).
  Cumple 3FN al no duplicar nombre, apellido ni DNI (que residen en usuario) y
  cumple privacidad informática al almacenar solo el token/hash de validación.
  '''
}

Table ubicacion {
  id_ubicacion bigint [pk, increment, note: 'Identificador único del lugar.']
  nombre_ubicacion varchar(150) [not null]
  direccion_ubicacion varchar(255) [not null]
  capacidad_maxima_ubicacion int [not null]
  activa_ubicacion boolean [not null, default: true]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (nombre_ubicacion, direccion_ubicacion) [unique, name: 'uq_ubicacion_nombre_direccion']
  }

  checks {
    `capacidad_maxima_ubicacion > 0` [name: 'chk_ubicacion_capacidad_positiva']
  }

  Note: '''
  Representa el lugar físico donde se realiza un evento. Evento guarda solamente
  la FK de la ubicación y no repite el nombre o la dirección.
  '''
}

Table categoria {
  id_categoria bigint [pk, increment, note: 'Identificador único de la categoría.']
  nombre_categoria varchar(100) [not null, unique]
  descripcion_categoria text
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Note: '''
  Clasifica eventos, por ejemplo Música, Teatro o Deportes. Una categoría puede
  utilizarse en muchos eventos.
  '''
}

Table evento {
  id_evento bigint [pk, increment, note: 'Identificador único del evento.']
  id_organizador bigint [not null, note: 'Usuario ORGANIZADOR responsable.']
  id_ubicacion bigint [not null, note: 'Lugar donde se realiza el evento.']
  id_categoria bigint [not null, note: 'Categoría utilizada para clasificar el evento.']
  titulo_evento varchar(200) [not null]
  descripcion_evento text
  fecha_evento date [not null]
  hora_evento time [not null]
  precio_actual_entrada decimal(10,2) [not null, note: 'Precio vigente para nuevas compras.']
  cupo_total_evento int [not null, note: 'Cantidad máxima de entradas que puede emitir el evento.']
  estado_evento estado_evento [not null, default: 'BORRADOR']
  imagen_url_evento text
  version_evento int [not null, default: 0, note: 'Control de concurrencia con @Version.']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    id_organizador [name: 'idx_evento_organizador']
    id_ubicacion [name: 'idx_evento_ubicacion']
    id_categoria [name: 'idx_evento_categoria']
    (estado_evento, fecha_evento) [name: 'idx_evento_estado_fecha']
  }

  checks {
    `precio_actual_entrada >= 0` [name: 'chk_evento_precio_no_negativo']
    `cupo_total_evento > 0` [name: 'chk_evento_cupo_positivo']
    `version_evento >= 0` [name: 'chk_evento_version_no_negativa']
  }

  Note: '''
  Publicación creada por un organizador. Los clientes sólo pueden ver eventos
  PUBLICADO que todavía tengan cupo. El cupo disponible no se guarda: se obtiene
  restando del cupo total las entradas CONFIRMADA o USADA.
  '''
}

Table compra {
  id_compra bigint [pk, increment, note: 'Identificador único de la operación.']
  id_cliente bigint [not null, note: 'Usuario verificado que realiza la compra.']
  fecha_compra timestamp [not null, default: `now()`]
  estado_compra estado_compra [not null, default: 'PENDIENTE']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (id_cliente, fecha_compra) [name: 'idx_compra_cliente_fecha']
  }

  Note: '''
  Cabecera de la operación. No contiene evento, cantidad ni total para evitar
  inconsistencias (3FN): esos datos se obtienen consultando las entradas de la compra.
  '''
}

Table pago {
  id_pago bigint [pk, increment, note: 'Identificador único de la transacción de pasarela.']
  id_compra bigint [not null, note: 'Compra asociada a este intento/operación de pago.']
  pasarela_pago pasarela_pago [not null, default: 'MERCADOPAGO']
  medio_pago medio_pago [not null, default: 'TARJETA_CREDITO']
  estado_pago estado_pago [not null, default: 'APROBADO']
  referencia_externa_pago varchar(120) [not null, unique, note: 'ID de transacción/token de idempotencia en la pasarela externa.']
  ultimos_cuatro_digitos varchar(4) [note: 'Solo se conservan los últimos 4 dígitos; no se guarda PAN ni CVV.']
  monto_pago decimal(10,2) [note: 'Monto autorizado por la pasarela; se cruza con la suma de entradas.']
  moneda_pago varchar(3) [default: 'ARS']
  codigo_autorizacion_pago varchar(50) [note: 'Código devuelto por la pasarela simulada o real.']
  fecha_pago timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    id_compra [name: 'idx_pago_compra']
  }

  Note: '''
  Transacción procesada por la pasarela de pago. No duplica el total calculado:
  monto_pago registra el importe efectivamente autorizado por la pasarela y se
  cruza contra la suma de entradas. No se guardan PAN ni CVV; solo referencias
  externas y los últimos cuatro dígitos.
  '''
}

Table comprobante {
  id_comprobante bigint [pk, increment, note: 'Identificador único del comprobante emitido.']
  id_pago bigint [not null, unique, note: 'Pago aprobado que origina este comprobante (3FN: evita duplicar id_compra e id_cliente).']
  numero_comprobante varchar(50) [not null, unique, note: 'Número fiscal/operativo único del comprobante.']
  tipo_comprobante tipo_comprobante [not null, default: 'RECIBO_DIGITAL']
  hash_cruce_seguridad varchar(64) [not null, unique, note: 'Firma SHA-256 que cruza compra, DNI verificado, pago y UUIDs de entradas emitidas.']
  estado_envio_comprobante estado_envio [not null, default: 'ENVIADO', note: 'Estado del envío digital de entradas y comprobante al cliente.']
  fecha_emision_comprobante timestamp [not null, default: `now()`]
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  Note: '''
  Resultado del método de cruce de información al comprar: vincula el pago aprobado,
  el envío de entradas y el hash criptográfico de integridad (SHA-256). Al referenciar
  a id_pago (UNIQUE), cumple 3FN sin dependencias transitivas hacia compra o usuario.
  '''
}

Table entrada {
  id_entrada bigint [pk, increment, note: 'Identificador interno del ticket.']
  codigo_unico_entrada uuid [not null, unique, default: `gen_random_uuid()`, note: 'Código UUID que identifica el ticket en el QR.']
  id_evento bigint [not null]
  id_cliente bigint [not null, note: 'Usuario titular en cuenta que administra la entrada.']
  id_compra bigint [note: 'Puede ser nulo para una entrada de cortesía.']
  dni_asistente_entrada varchar(20) [not null, note: 'Documento nominal del asistente que ingresará físicamente al evento.']
  nombre_asistente_entrada varchar(150) [not null, note: 'Nombre y apellido nominal impreso en el ticket al momento de emisión.']
  estado_entrada estado_entrada [not null, default: 'CONFIRMADA']
  precio_pagado_entrada decimal(10,2) [not null, note: 'Precio histórico congelado al momento de emitir el ticket.']
  fecha_emision_entrada timestamp [not null, default: `now()`]
  fecha_validacion_entrada timestamp [note: 'Momento del primer uso en puerta; nulo mientras no fue utilizada.']
  version_entrada int [not null, default: 0, note: 'Evita validar dos veces el mismo ticket en simultáneo (@Version).']
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (id_evento, estado_entrada) [name: 'idx_entrada_evento_estado']
    (id_cliente, estado_entrada) [name: 'idx_entrada_cliente_estado']
    (id_evento, dni_asistente_entrada) [name: 'idx_entrada_evento_dni_nominal']
    id_compra [name: 'idx_entrada_compra']
  }

  checks {
    `precio_pagado_entrada >= 0` [name: 'chk_entrada_precio_no_negativo']
    `((estado_entrada = 'USADA' AND fecha_validacion_entrada IS NOT NULL) OR (estado_entrada <> 'USADA' AND fecha_validacion_entrada IS NULL))` [name: 'chk_entrada_validacion_coherente']
    `version_entrada >= 0` [name: 'chk_entrada_version_no_negativa']
  }

  Note: '''
  Cada fila es un ticket individual y NOMINAL. Permite que un comprador verificado
  adquiera varias entradas asignando el DNI y nombre de cada asistente real, evitando
  la reventa y permitiendo verificar QR + DNI físico en puerta.
  '''
}

Table historial_estado_entrada {
  id_historial_entrada bigint [pk, increment]
  id_entrada bigint [not null]
  estado_anterior_entrada estado_entrada
  estado_nuevo_entrada estado_entrada [not null]
  id_usuario_responsable bigint [note: 'Usuario que realizó el cambio; puede ser nulo si fue automático.']
  motivo_cambio_entrada varchar(300)
  fecha_cambio_entrada timestamp [not null, default: `now()`]

  indexes {
    (id_entrada, fecha_cambio_entrada) [name: 'idx_historial_entrada_fecha']
  }

  checks {
    `estado_anterior_entrada IS NULL OR estado_anterior_entrada <> estado_nuevo_entrada` [name: 'chk_historial_entrada_cambio_real']
  }

  Note: '''
  Trazabilidad específica del ciclo de vida del ticket. Registra cuándo fue emitido,
  validado en puerta o anulado.
  '''
}

Table notificacion {
  id_notificacion bigint [pk, increment]
  id_usuario_destinatario bigint [not null]
  id_evento_relacionado bigint [note: 'Opcional: una notificación general no necesita evento.']
  mensaje_notificacion text [not null]
  tipo_notificacion varchar(20) [not null, default: 'INFO']
  leida_notificacion boolean [not null, default: false]
  fecha_creacion_notificacion timestamp [not null, default: `now()`]
  fecha_envio_notificacion timestamp
  created_at timestamp [not null, default: `now()`]
  updated_at timestamp

  indexes {
    (id_usuario_destinatario, fecha_creacion_notificacion) [name: 'idx_notificacion_usuario_fecha']
    id_evento_relacionado [name: 'idx_notificacion_evento']
  }

  checks {
    `fecha_envio_notificacion IS NULL OR fecha_envio_notificacion >= fecha_creacion_notificacion` [name: 'chk_notificacion_fecha_envio']
  }

  Note: '''
  Mensaje enviado a un usuario (ej. confirmación de cruce de compra, envío de
  comprobante y entradas, verificación KYC o cancelación de evento).
  '''
}

Table auditoria_seguridad {
  id_auditoria bigint [pk, increment, note: 'Identificador único del evento de tracking.']
  id_usuario bigint [note: 'Usuario que ejecutó la acción; nulo en intentos anónimos fallidos.']
  accion_auditoria varchar(50) [not null, note: 'LOGIN, REGISTRO, VERIFICACION_KYC, CRUCE_COMPRA, PAGO_PASARELA, VALIDACION_PUERTA.']
  entidad_afectada varchar(50) [not null, note: 'Tabla/entidad sobre la que impactó la acción.']
  id_registro_afectado bigint [note: 'ID de la fila afectada en la entidad correspondiente.']
  resultado_auditoria varchar(20) [not null, default: 'EXITOSO', note: 'EXITOSO, RECHAZADO o BLOQUEADO.']
  ip_origen varchar(45) [note: 'Dirección IPv4/IPv6 para análisis antifraude y seguridad informática.']
  detalle_tracking varchar(500) [not null, note: 'Descripción trazable sin exponer datos sensibles.']
  fecha_auditoria timestamp [not null, default: `now()`]

  indexes {
    (id_usuario, fecha_auditoria) [name: 'idx_auditoria_usuario_fecha']
    (accion_auditoria, fecha_auditoria) [name: 'idx_auditoria_accion_fecha']
  }

  Note: '''
  Bitácora inmutable (append-only) para trackear datos operativos y de seguridad
  informática (cumplimiento OWASP Logging & Monitoring / ISO 27001).
  '''
}

Ref fk_usuario_rol: usuario.id_rol > rol.id_rol [delete: restrict, update: cascade]
Ref fk_verificacion_usuario: verificacion_identidad.id_usuario - usuario.id_usuario [delete: restrict, update: cascade]

Ref fk_evento_organizador: evento.id_organizador > usuario.id_usuario [delete: restrict, update: cascade]
Ref fk_evento_ubicacion: evento.id_ubicacion > ubicacion.id_ubicacion [delete: restrict, update: cascade]
Ref fk_evento_categoria: evento.id_categoria > categoria.id_categoria [delete: restrict, update: cascade]

Ref fk_compra_cliente: compra.id_cliente > usuario.id_usuario [delete: restrict, update: cascade]
Ref fk_pago_compra: pago.id_compra > compra.id_compra [delete: restrict, update: cascade]
Ref fk_comprobante_pago: comprobante.id_pago - pago.id_pago [delete: restrict, update: cascade]

Ref fk_entrada_evento: entrada.id_evento > evento.id_evento [delete: restrict, update: cascade]
Ref fk_entrada_cliente: entrada.id_cliente > usuario.id_usuario [delete: restrict, update: cascade]
Ref fk_entrada_compra: entrada.id_compra >? compra.id_compra [delete: restrict, update: cascade]

Ref fk_historial_entrada: historial_estado_entrada.id_entrada > entrada.id_entrada [delete: restrict, update: cascade]
Ref fk_historial_responsable: historial_estado_entrada.id_usuario_responsable >? usuario.id_usuario [delete: restrict, update: cascade]

Ref fk_notificacion_usuario: notificacion.id_usuario_destinatario > usuario.id_usuario [delete: restrict, update: cascade]
Ref fk_notificacion_evento: notificacion.id_evento_relacionado >? evento.id_evento [delete: set null, update: cascade]

Ref fk_auditoria_usuario: auditoria_seguridad.id_usuario >? usuario.id_usuario [delete: set null, update: cascade]

TableGroup identidad_y_usuarios [color: #2563EB] {
  rol
  usuario
  verificacion_identidad
}

TableGroup catalogo_eventos [color: #16A34A] {
  ubicacion
  categoria
  evento
}

TableGroup ventas_pagos_y_entradas [color: #EA580C] {
  compra
  pago
  comprobante
  entrada
}

TableGroup trazabilidad_y_seguridad [color: #7C3AED] {
  historial_estado_entrada
  notificacion
  auditoria_seguridad
}
